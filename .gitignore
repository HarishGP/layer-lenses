# Python cache / compiled files
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Coverage / test artifacts
.coverage
.coverage.*
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# Mac / editor noise
.DS_Store

# Local env / secrets
.env
.env.*

# Generated experiment outputs
results/*
!results/.gitkeep
